# Copy this file to .env and fill in real values. Never commit the .env file itself.

DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Date used to determine "today" vs "yesterday" on the dashboard (YYYY-MM-DD)
POLLING_DATE=2026-01-01
